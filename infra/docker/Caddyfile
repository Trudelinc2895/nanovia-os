{
    servers {
        # Cloudflare ranges verified 2026-10-04 against /ips-v4 and /ips-v6.
        # Trust the connecting CDN peer, never an arbitrary private address.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
    email {$ACME_EMAIL}
}

(security_headers) {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self';"
        -Server
        -X-Powered-By
    }
}

(block_attackers) {
    @scanners header_regexp User-Agent "(nikto|sqlmap|masscan|nmap|zgrab|dirbuster|gobuster|wfuzz|hydra|medusa|metasploit|burpsuite|acunetix|nessus|openvas|w3af|python-requests/2\.[0-2])"
    respond @scanners 403

    @sqli path_regexp "(union.*select|select.*from|drop.*table|insert.*into|exec.*\()"
    respond @sqli 403

    @path_traversal path_regexp "(\.\./|\.\.\\\\|%2e%2e)"
    respond @path_traversal 403

    @bad_methods not method GET POST PUT PATCH DELETE OPTIONS HEAD
    respond @bad_methods 405
}

(rate_limit_api) {
    rate_limit {
        zone api_zone {
            key    {remote_host}
            events 100
            window 1m
        }
    }
}

(admin_ip_allow) {
    @not_allowed not remote_ip {$ADMIN_ALLOWED_IP}
    respond @not_allowed 403
}

# ── Canonical app site ────────────────────────────────────────────────────────
{$DOMAIN}, www.{$DOMAIN} {
    import security_headers
    import block_attackers

    @www host www.{$DOMAIN}
    redir @www https://{$DOMAIN}{uri} permanent

    handle /api/* {
        reverse_proxy api:8010 {
            # Send exactly one address, resolved at the trusted Caddy boundary.
            # Never pass a caller-controlled forwarding chain to the API.
            header_up X-Forwarded-For {client_ip}
        }
    }

    handle {
        reverse_proxy web:3000
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# Dedicated api/admin/monitor hosts stay disabled in the default production
# Caddyfile until their DNS records are confirmed live. The public app runs in
# same-origin mode through {$DOMAIN} with /api/* proxied to FastAPI.

# ── Raw IP behavior ────────────────────────────────────────────────────────────
http://{$PUBLIC_IP} {
    redir https://{$DOMAIN}{uri} permanent
}

# ── Redirect HTTP → HTTPS (fallback) ─────────────────────────────────────────
http:// {
    redir https://{host}{uri} permanent
}
