# Nanovia OS — isolated staging environment template
# Copy to .env.staging on the staging VPS and replace every CHANGE_ME/REPLACE_ME value.
# Never commit a populated .env.staging file.

APP_ENV=staging
APP_NAME=Nanovia OS
APP_VERSION=1.0.0
APP_RUNTIME_ENV_FILE=../.env.staging
SECRET_PROVIDER=env
DOMAIN=staging.nanovia.ca
ACME_EMAIL=admin@nanovia.ca
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
LOG_LEVEL=INFO
PUBLIC_IP=REPLACE_ME_PUBLIC_IP

POSTGRES_DB=nanovia_staging
POSTGRES_USER=nanovia_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_STAGING_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://postgres:5432/nanovia_staging

REDIS_PASSWORD=CHANGE_ME_STRONG_STAGING_REDIS_PASSWORD
REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_TEST_SECRET_KEY
STRIPE_PUBLIC_KEY=REPLACE_WITH_STRIPE_TEST_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_TEST_WEBHOOK_SECRET
STRIPE_PRICE_PRO_MONTHLY_ID=price_...
STRIPE_PRICE_PRO_YEARLY_ID=price_...
STRIPE_PRICE_BUSINESS_MONTHLY_ID=price_...
STRIPE_PRICE_BUSINESS_YEARLY_ID=price_...
STRIPE_CREDIT_PRICE_ID=price_...
STRIPE_CREDIT_PACK_SIZE=10
STRIPE_CREDIT_UNIT_AMOUNT=0
STRIPE_CREDIT_CURRENCY=
STRIPE_CREDIT_PREVIOUS_PRODUCTS_JSON={}
STRIPE_PILOT_PREVIOUS_CONTRACTS_JSON=[]

RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TOTP_ENCRYPTION_KEY=GENERATE_WITH_FERNET_AND_SET_HERE

API_BASE_URL=http://127.0.0.1:18010
NEXT_PUBLIC_API_URL=http://127.0.0.1:18010
PUBLIC_WEB_URL=http://127.0.0.1:13000
PRIVATE_ADMIN_URL=http://127.0.0.1:13020
CONTROL_CENTER_OWNER_EMAIL=REPLACE_ME_OWNER_EMAIL
ADMIN_ALLOWED_IP=127.0.0.1/32
ALLOWED_ORIGINS_RAW=http://127.0.0.1:13000,http://127.0.0.1:13020

STAGING_BIND_ADDRESS=127.0.0.1
STAGING_WEB_PORT=13000
STAGING_ADMIN_PORT=13020
STAGING_API_PORT=18010
STAGING_AI_PORT=18020

SCRAPING_REQUIRE_AUTH=false
SCRAPING_STEALTH_MODE=false
APP_REGION=us-east-1
CHAOS_ENABLED=false
